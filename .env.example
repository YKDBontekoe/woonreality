# Supabase is the only application backend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase secret key. Never expose this as NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=

# Configure these in the Supabase Dashboard for hosted environments; see
# docs/auth-setup.md. Keep the WebAuthn RP ID stable after passkeys are enrolled.

# Required only for DSO/EP-Online adapters when those features are enabled.
DSO_API_KEY=
EPONLINE_API_KEY=

# Protects Vercel Cron endpoints. Set the same value in Vercel project settings.
CRON_SECRET=

# Optional Mapbox style override. The default is mapbox://styles/mapbox/streets-v12.
NEXT_PUBLIC_MAP_STYLE_URL=
# Public Mapbox token (pk.*). Required for the interactive map; the UI keeps a fallback without it.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional: licensed market-data feed. Do not point this at an undocumented
# portal endpoint; configure only a provider whose terms permit this use.
LISTING_PROVIDER_URL=
LISTING_PROVIDER_API_KEY=
LISTING_PROVIDER_NAME=

# Optional AI property research via Vercel AI Gateway. Requires Supabase configuration for persistent reports.
AI_GATEWAY_API_KEY=
AI_RESEARCH_MODEL=openai/gpt-5-mini
AI_SYNTHESIS_MODEL=openai/gpt-5.4
AI_REPORT_TTL_DAYS=7
AI_ALLOWED_DOMAINS=
LISTING_PAGE_FETCH_ENABLED=false
LISTING_ALLOWED_HOSTS=
