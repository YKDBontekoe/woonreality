# Supabase is the only application backend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase secret key. Never expose this as NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=

# Configure these in the Supabase Dashboard for hosted environments; see
# docs/auth-setup.md. Production RP ID must be woonreality.vercel.app
# (or a future custom domain). Keep the WebAuthn RP ID stable after enrolment.
# Optional: SUPABASE_ACCESS_TOKEN for `npm run db:enable-passkeys`.

# Set to "false" to allow unauthenticated address search (local development).
# When omitted (or any other value), login is required when Supabase is configured.
REQUIRE_LOGIN_FOR_SEARCH=

# Required only for DSO/EP-Online adapters when those features are enabled.
DSO_API_KEY=
EPONLINE_API_KEY=

# Protects Vercel Cron endpoints. Set the same value in Vercel project settings.
CRON_SECRET=

# Optional Mapbox style override. The default is mapbox://styles/mapbox/standard (3D).
NEXT_PUBLIC_MAP_STYLE_URL=
# Public Mapbox token (pk.*). Required to render the Mapbox Standard 3D map. There is no OSM fallback.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional: licensed market-data feed. Do not point this at an undocumented
# portal endpoint; configure only a provider whose terms permit this use.
LISTING_PROVIDER_URL=
LISTING_PROVIDER_API_KEY=
LISTING_PROVIDER_NAME=

# Optional AI property research via Vercel AI Gateway. Requires Supabase configuration for persistent reports.
# Defaults: GPT-5.6 Luna with medium reasoning on synthesis (override to Terra/Sol if needed).
AI_GATEWAY_API_KEY=
AI_RESEARCH_MODEL=openai/gpt-5.6-luna
AI_SYNTHESIS_MODEL=openai/gpt-5.6-luna
AI_REPORT_TTL_DAYS=7
# Extra domains the AI web-search step may cite as a source, beyond the built-in official list.
AI_ALLOWED_DOMAINS=
# Only used as a fallback to fetch a listing PAGE when no description text was captured at all.
# A user's own captured Funda/listing text (via the extension or paste-import) is always used as
# AI input and does not need this allowlist; it is treated as consented, already-stored data.
LISTING_PAGE_FETCH_ENABLED=false
LISTING_ALLOWED_HOSTS=

# Public Vercel Blob is used for the latest browser-extension release.
# Vercel adds this automatically when a Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=
WOONREALITY_APP_URL=https://woonreality.vercel.app
